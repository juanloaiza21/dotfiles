/* App launcher (SUPER+R): centered rounded card, same palette as waybar. */

@theme "~/.config/rofi/cyber.rasi"

configuration {
  font:                     "JetBrainsMono Nerd Font 12";
  show-icons:               true;
  icon-theme:               "Papirus-Dark";
  display-drun:             "󰀻  Apps";
  display-window:           "󱂬  Windows";
  display-combi:            "";
  combi-display-format:     "{text}";
  drun-display-format:      "{name}";
  window-format:            "{c}  ·  {t}";
  hover-select:             true;
  me-select-entry:          "MousePrimary";
  me-accept-entry:          "!MousePrimary";
}

window {
  location:                 center;
  anchor:                   center;
  width:                    620px;
  border:                   1px;
  border-radius:            16px;
  border-color:             @main-br;
  background-color:         #160914fb;
  children:                 [ mainbox ];
}

mainbox {
  spacing:                  12px;
  padding:                  16px;
  background-color:         transparent;
  children:                 [ inputbar, listview ];
}

inputbar {
  spacing:                  10px;
  padding:                  12px 16px;
  border:                   1px;
  border-radius:            12px;
  border-color:             @main-br;
  background-color:         #ffffff0d;
  text-color:               @main-fg;
  children:                 [ prompt, entry ];
}
prompt {
  text-color:               @select-bg;
  background-color:         transparent;
}
entry {
  placeholder:              "Buscar apps o ventanas…";
  placeholder-color:        @muted;
  text-color:               @main-fg;
  background-color:         transparent;
  cursor:                   text;
}

listview {
  lines:                    8;
  columns:                  1;
  spacing:                  4px;
  fixed-height:             true;
  scrollbar:                false;
  background-color:         transparent;
}

element {
  padding:                  8px 12px;
  spacing:                  12px;
  border-radius:            10px;
  cursor:                   pointer;
  background-color:         transparent;
  text-color:               @main-fg;
}
element normal.normal, element alternate.normal {
  background-color:         transparent;
  text-color:               @main-fg;
}
element selected.normal {
  background-color:         @select-bg;
  text-color:               @select-fg;
}
element-icon {
  size:                     28px;
  background-color:         transparent;
}
element-text {
  vertical-align:           0.5;
  background-color:         transparent;
  text-color:               inherit;
  highlight:                bold underline;
}
