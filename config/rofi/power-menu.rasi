/* Power menu: rounded pills to match the waybar style. */

@theme "~/.config/rofi/cyber.rasi"

configuration {
  font:                     "JetBrainsMono Nerd Font 11";
  hover-select:             true;
  me-select-entry:          "MousePrimary";
  me-accept-entry:          "!MousePrimary";
}

window {
  location:                 northeast;
  anchor:                   northeast;
  x-offset:                 -10px;
  y-offset:                 6px;
  width:                    210px;
  border:                   1px;
  border-radius:            10px;
  border-color:             @main-br;
  background-color:         @main-bg;
  children:                 [ mainbox ];
}

mainbox {
  spacing:                  0;
  padding:                  6px;
  background-color:         transparent;
  children:                 [ listview ];
}

listview {
  lines:                    6;
  spacing:                  4px;
  fixed-height:             true;
  scrollbar:                false;
  background-color:         transparent;
}

element {
  padding:                  8px 12px;
  border-radius:            8px;
  cursor:                   pointer;
  background-color:         transparent;
  text-color:               @main-fg;
}
element normal.normal {
  background-color:         transparent;
  text-color:               @main-fg;
}
element selected.normal {
  background-color:         @select-bg;
  text-color:               @select-fg;
}
element-text {
  vertical-align:           0.5;
  cursor:                   inherit;
  background-color:         transparent;
  text-color:               inherit;
}
