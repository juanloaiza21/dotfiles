{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "color": { "1": "38;2;247;37;133", "2": "38;2;181;23;158" },
    "padding": { "top": 1, "left": 2, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "38;2;247;37;133", "title": "38;2;181;23;158", "output": "38;2;244;232;241" }
  },
  "modules": [
    "title", "separator", "os", "host", "kernel", "uptime", "packages", "shell",
    { "type": "display", "key": "Display", "format": "{width}x{height} @ {refresh-rate}Hz" }, "wm", "terminal", "cpu", "gpu", "memory", "disk", "localip",
    "break", "colors"
  ]
}
